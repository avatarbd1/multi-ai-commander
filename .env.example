# GitHub App credential broker configuration (required for authenticated operations).
# Never use GITHUB_TOKEN or GH_TOKEN — Commander uses GitHub App credential broker.

# Numeric GitHub App ID
COMMANDER_GH_APP_ID=

# Positive integer installation ID
COMMANDER_GH_INSTALLATION_ID=

# Private key in PEM format (do not commit; load from GitHub Actions Secrets in CI)
COMMANDER_GH_PRIVATE_KEY=

# Optional: Live installation verification target repository (owner/repo format)
# Verify the app has access to this repository. Only needed for setup validation.
# COMMANDER_GH_VERIFY_REPOSITORY=
